{
  "name": "idea-trace-validation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "dev": "npm run dev --workspace @idea/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:acceptance": "tsx scripts/acceptance.ts",
    "test:acceptance:lp01": "vitest run --config vitest.acceptance.config.ts apps/api/test/lp01.acceptance.test.ts",
    "test:acceptance:lp02": "vitest run --config vitest.acceptance.config.ts apps/api/test/lp02.acceptance.test.ts",
    "test:acceptance:lp03": "vitest run --config vitest.acceptance.config.ts apps/api/test/lp03-report-api.acceptance.test.ts",
    "test": "npm run test:unit && npm run test:contract && npm run test:integration && npm run test:acceptance",
    "report-types:generate": "tsx scripts/generate-report-types.ts",
    "report-types:check": "tsx scripts/check-report-types.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "db:migrate": "tsx packages/db/src/cli/migrate.ts",
    "db:migrate:test": "tsx packages/db/src/cli/migrate.ts --test",
    "test:db:up": "tsx scripts/test-db.ts up",
    "test:db:down": "tsx scripts/test-db.ts down",
    "verify": "npm run format:check && npm run lint && npm run report-types:check && npm run typecheck && npm run build && npm run openapi:check && npm run test"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.0",
    "json-schema-to-ts": "3.1.1",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
