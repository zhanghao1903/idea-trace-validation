{
  "name": "idea-trace-validation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": false,
    "fsevents@2.3.3": true
  },
  "scripts": {
    "build": "tsc -b && npm run build --workspace @idea/web",
    "clean": "tsc -b --clean",
    "dev": "npm run dev --workspace @idea/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false && npm run typecheck:e2e --workspace @idea/web",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:web:component": "vitest run --config vitest.web.config.ts",
    "test:browser": "playwright test",
    "test:browser:lp04": "npm run build && playwright test --config playwright.lp04.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:acceptance": "tsx scripts/acceptance.ts",
    "test:acceptance:lp01": "vitest run --config vitest.acceptance.config.ts apps/api/test/lp01.acceptance.test.ts",
    "test:acceptance:lp02": "vitest run --config vitest.acceptance.config.ts apps/api/test/lp02.acceptance.test.ts",
    "test:acceptance:lp03": "vitest run --config vitest.acceptance.config.ts apps/api/test/lp03-*.acceptance.test.ts",
    "test:acceptance:lp04": "vitest run --config vitest.acceptance.config.ts apps/api/test/lp04-demo.acceptance.test.ts",
    "skill:check": "tsx scripts/lp04/check-skill.ts",
    "demo:lp04": "tsx scripts/lp04/run.ts",
    "demo:lp04:verify": "tsx scripts/lp04/verify-run.ts",
    "demo:lp04:human": "tsx scripts/lp04/human-facilitator.ts",
    "demo:lp04:verify-client": "tsx scripts/lp04/verify-client-evidence.ts",
    "release:lp05:candidate": "tsx scripts/lp05/candidate/build.ts",
    "release:lp05:verify-candidate": "tsx scripts/lp05/candidate/verify.ts",
    "deploy:lp05:validate": "tsx scripts/lp05/verify-release-readiness.ts",
    "deploy:lp05:smoke": "tsx scripts/lp05/smoke/run.ts",
    "deploy:lp05:verify-evidence": "tsx scripts/lp05/smoke/verify-evidence.ts",
    "backup:lp05": "tsx scripts/lp05/database/backup-cli.ts",
    "restore:lp05": "tsx scripts/lp05/database/restore-cli.ts",
    "rotate:lp05": "tsx scripts/lp05/deploy/rotate-credentials-cli.ts",
    "ops:lp05": "tsx scripts/lp05/deploy/ops-status-cli.ts",
    "test:deployment:unit": "vitest run --config vitest.unit.config.ts scripts/lp05",
    "test:deployment:authority": "vitest run --config vitest.unit.config.ts scripts/lp05/shared/contracts.unit.test.ts",
    "test:deployment:restore-chain": "vitest run --config vitest.unit.config.ts scripts/lp05/database/database.unit.test.ts scripts/lp05/shared/contracts.unit.test.ts",
    "test:deployment:local": "tsx scripts/lp05/local-acceptance.ts",
    "test:backup-restore:lp05": "vitest run --config vitest.unit.config.ts scripts/lp05/database/database.unit.test.ts",
    "test:rotation:lp05": "vitest run --config vitest.unit.config.ts scripts/lp05/deploy/rotation-rollback.unit.test.ts -t rotation",
    "test:deployment:rollback": "vitest run --config vitest.unit.config.ts scripts/lp05/deploy/rotation-rollback.unit.test.ts -t rollback",
    "test": "npm run test:unit && npm run test:contract && npm run test:integration && npm run test:web:component && npm run test:acceptance",
    "report-types:generate": "tsx scripts/generate-report-types.ts",
    "report-types:check": "tsx scripts/check-report-types.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "db:migrate": "tsx packages/db/src/cli/migrate.ts",
    "db:migrate:test": "tsx packages/db/src/cli/migrate.ts --test",
    "test:db:up": "tsx scripts/test-db.ts up",
    "test:db:down": "tsx scripts/test-db.ts down",
    "verify": "npm run format:check && npm run lint && npm run skill:check && npm run report-types:check && npm run typecheck && npm run build && npm run openapi:check && npm run test && npm run test:deployment:unit && npm run deploy:lp05:validate && npm run test:browser && npm run test:browser:lp04"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.0",
    "json-schema-to-ts": "3.1.1",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
